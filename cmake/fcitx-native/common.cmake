set(FUSION_UPSTREAM_DIR "" CACHE PATH "Pinned official source checkouts")
get_filename_component(FUSION_NATIVE_SUPPORT_DIR "${CMAKE_CURRENT_LIST_DIR}" ABSOLUTE)
find_package(PThreads4W CONFIG REQUIRED)
if(NOT TARGET Pthread::Pthread)
  add_library(Pthread::Pthread ALIAS PThreads4W::PThreads4W)
endif()
include_directories("${PThreads4W_INCLUDE_DIR}" "${FUSION_NATIVE_SUPPORT_DIR}/compat")
add_compile_definitions(NOMINMAX WIN32_LEAN_AND_MEAN _CRT_SECURE_NO_WARNINGS _CRT_NONSTDC_NO_WARNINGS)
add_compile_options(/utf-8 /Zc:preprocessor /Zc:__cplusplus "/FI${FUSION_NATIVE_SUPPORT_DIR}/compat/unistd.h")
