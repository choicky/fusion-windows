# Out-of-source build directories (the documented `cmake -S . -B build` path)
/build*/

# Accidental in-source CMake/CTest artifacts. Only appear if configured without
# `-B`; never project source, so anchoring them at the repository root is narrow.
/CMakeCache.txt
/CMakeFiles/
/CTestTestfile.cmake
/cmake_install.cmake
/Testing/
/compile_commands.json

# Local editor scratch (vim swap / backup); never project content.
*.swp
*~

# Local agent/workspace data; never project content, and an untracked entry here
# would make every package manifest look "dirty".
/.workbuddy-ai/

# .NET build output for the C# settings client (src/settings-winui3). Anchored so a
# stray directory named bin/obj elsewhere is still visible to review.
/src/settings-winui3/**/bin/
/src/settings-winui3/**/obj/
