<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Focused checks for the settings client core. No test framework: this environment
    cannot restore packages, and the checks are ordinary assertions over the same
    public surface the UI will use. Exit code 0 means every check passed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Style analyzers add noise for assertion code; compiler warnings stay errors. -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <RootNamespace>Fusion.Settings.Tests</RootNamespace>
    <AssemblyName>FusionSettings.Core.Tests</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FusionSettings.Core\FusionSettings.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The display table is compiled from the same file the window compiles, so a label and a
      stored-value map can be checked without starting the UI. The file is presentation data
      and depends on nothing but the base class library; if it ever gains a WinUI dependency
      this reference stops compiling, which is the intended signal rather than a copy.
    -->
    <Compile Include="..\FusionSettings.App\Services\PresentationMap.cs"
             Link="Presentation\PresentationMap.cs" />
  </ItemGroup>

</Project>
