<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Focused checks for the settings client core. No test framework: this environment
    cannot restore packages, and the checks are ordinary assertions over the same
    public surface the UI will use. Exit code 0 means every check passed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Style analyzers add noise for assertion code; compiler warnings stay errors. -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <RootNamespace>Fusion.Settings.Tests</RootNamespace>
    <AssemblyName>FusionSettings.Core.Tests</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FusionSettings.Core\FusionSettings.Core.csproj" />
  </ItemGroup>

</Project>
